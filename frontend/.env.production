# The API is served by the same Express process as this bundle, so the base
# URL is relative and the deployment is a single origin with no CORS hop.
VITE_API_URL=/api

# Must match GOOGLE_CLIENT_ID in backend/.env — Google sign-in verifies the
# ID token against it and fails if the two diverge.
VITE_GOOGLE_CLIENT_ID=838404322364-ar8kv57qvbq8511csn9turiqbs2khhdd.apps.googleusercontent.com
