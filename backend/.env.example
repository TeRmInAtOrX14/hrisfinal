# ==============================================================================
# Brandigade HRIS — backend environment template
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==============================================================================

# ---- Server ------------------------------------------------------------------
PORT=4000
# 'production' makes missing secrets fatal and hides internal errors from clients.
NODE_ENV=development
# Origin of the front end. Required for CORS in production.
FRONTEND_URL=http://localhost:5173
# Where the built SPA lives, relative to backend/src (or an absolute path).
# Leave blank to use this repository's layout (../../frontend/dist). Express
# serves it, so the API and the app share one origin in production.
FRONTEND_DIST=

# ---- Database (required) -----------------------------------------------------
# DATABASE_URL: transaction pooler (port 6543), used by the app at runtime.
# DIRECT_URL:   session pooler (port 5432), used by Prisma Migrate.
#
# Use the POOLER host for BOTH. Supabase's direct host
# (db.<ref>.supabase.co:5432) resolves to IPv6 only, so any host without
# IPv6 -- most shared hosting, cPanel included -- fails with
# "P1001: Can't reach database server". The pooler is reachable over IPv4.
#
# DIRECT_URL is DATABASE_URL with port 5432 and no query string. Note the
# pooler username is postgres.<project-ref>, not plain postgres.
DATABASE_URL="postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Hosts that block outbound PostgreSQL ports -------------------------------
# Most shared hosting (Namecheap cPanel included) allows outbound HTTPS but
# blocks ports 5432 and 6543, so neither URL above can connect. Route queries
# through Prisma Accelerate over port 443 instead: create a project at
# console.prisma.io, point it at this database, and set DATABASE_URL to the
# prisma:// URL it issues:
#
#   DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=<key>"
#
# src/lib/prisma.js switches transports on that prefix alone — no other change
# is needed. DIRECT_URL stays a real postgresql:// URL; it is used only by
# `prisma migrate` and `npm run seed`, which you run from a machine that can
# open a normal connection, never from the restricted host.

# ---- Authentication (required) -----------------------------------------------
# There are NO fallback values. In production the server refuses to start
# without these; in development it warns and uses a random per-boot secret.
# The two secrets must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Google SSO --------------------------------------------------------------
# Must match the frontend's VITE_GOOGLE_CLIENT_ID. Google sign-in is rejected
# unless this is set, because the ID token is verified against it.
GOOGLE_CLIENT_ID=

# ---- Supabase Storage --------------------------------------------------------
# Buckets 'payslips' and 'employee-documents' must exist and must be PRIVATE.
# They hold payroll records and HR documents; files are served through signed
# URLs and authenticated endpoints, never public links.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase Management API token (CLI / tooling only — not used at runtime).
SUPABASE_ACCESS_TOKEN=

# ---- Email (optional) --------------------------------------------------------
# When unset, mail is skipped with a warning instead of failing the action.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Attendance & biometrics -------------------------------------------------
# TIMEZONE drives every attendance date and late calculation. Set it to the
# OFFICE timezone, not the server's — a cloud host in UTC would otherwise
# mis-date punches and mis-score lateness by the offset.
TIMEZONE=Asia/Karachi
OFFICE_START_TIME=09:30
OFFICE_END_TIME=18:30

# Shared secret for the office-side sync agent (x-sync-token header).
# Must match sync-agent/.env. Punch ingestion is rejected when unset.
SYNC_AGENT_TOKEN=

# Direct TCP pull from the device. Only enable when the API itself runs on the
# office LAN; the normal setup is the sync agent pushing to the API.
ZKTECO_IP=
ZKTECO_PORT=4370
ENABLE_DIRECT_ZK_SYNC=false
ZK_SYNC_INTERVAL_MS=7200000

# ---- Payroll policy ----------------------------------------------------------
# These were hard-coded constants inside the payroll loop. Changing them here
# changes future runs without a code change.
ATTENDANCE_ALLOWANCE=2500
PUNCTUALITY_ALLOWANCE=2500
# Attendance allowance is forfeited above this many approved leave days.
ATTENDANCE_ALLOWANCE_MAX_LEAVE_DAYS=1
# Every N late arrivals costs one day of salary. Set to 0 to disable.
LATES_PER_DAY_DEDUCTION=3
# Extra per-show-up amount for 'hybrid' commission slabs.
HYBRID_PER_SHOWUP_BONUS=2000

# Team Lead payout ladder (JSON). A lead clears a rung when the team's total
# show-ups reach showupsPerMember * teamSize + 1.
# TEAM_LEAD_COMMISSION_LADDER=[{"showupsPerMember":10,"payout":22000},{"showupsPerMember":8,"payout":18000},{"showupsPerMember":6,"payout":14000},{"showupsPerMember":4,"payout":10000}]
# Campaigns the ladder applies to; others fall back to their own slab table.
# TEAM_LEAD_LADDER_CAMPAIGNS=["LVGL","CLEO HR","PATIENT WING","LOGICS","BRANDIGADE OUTREACH"]

# ---- Company details (payslip header) ----------------------------------------
COMPANY_NAME=Brandigade
COMPANY_ADDRESS=Karachi, Pakistan

# ---- Documents ---------------------------------------------------------------
MAX_DOCUMENT_BYTES=10485760

# ---- Initial admin (used by `npm run seed`) ----------------------------------
ADMIN_EMAIL=
ADMIN_NAME=
# Leave blank to have a strong password generated and printed once.
ADMIN_PASSWORD=
