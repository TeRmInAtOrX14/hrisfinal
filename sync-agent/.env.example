# Where the HRIS API lives. Must include the /api suffix.
HRIS_API_URL=https://api.brandigade.com/api

# Shared secret. Must match SYNC_AGENT_TOKEN in the server's environment.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SYNC_AGENT_TOKEN=

# ZKTeco device on the office LAN
ZKTECO_IP=192.168.1.201
ZKTECO_PORT=4370
ZKTECO_TIMEOUT_MS=10000

# How many days of punches to read on a normal run. The overlap is deliberate —
# the server upserts, so re-sending is harmless and covers missed runs.
LOOKBACK_DAYS=3

# Window used by `npm run full-sync` for the initial backfill.
FULL_LOOKBACK_DAYS=60

# Punches per HTTP request.
BATCH_SIZE=2000
